# Build context: src/ (docker build -f webAPI/Dockerfile.production src)
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Project files first: the restore layer stays cached until a .csproj changes
COPY ["webAPI/TO2.csproj", "webAPI/"]
COPY ["Application/Application.csproj", "Application/"]
COPY ["Domain/Domain.csproj", "Domain/"]
COPY ["Infrastructure/Infrastructure.csproj", "Infrastructure/"]
RUN dotnet restore "webAPI/TO2.csproj"

COPY . .
RUN dotnet publish "webAPI/TO2.csproj" -c Release -o /app/publish --no-restore /p:UseAppHost=false

# Runtime image only: no SDK, no source
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/publish .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "TO2.dll"]
